{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "outDir": "dist",
    "stripInternal": true,
    "esModuleInterop": true,
    "skipLibCheck": true
    // "noErrorTruncation": true
  },
  "include": [
    "src/**/*"
  ]
}
