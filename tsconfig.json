{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "outDir": "dist",
    "stripInternal": true,
    "esModuleInterop": true,
    "skipLibCheck": true
    // "noErrorTruncation": true
  },
  "include": [
    "src/**/*",
    "eslint.config.js",
    "vite.config.lib-build.ts"
  ]
}
